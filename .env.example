# Forge environment. Copy to .env; the server, the CLI and scripts/preflight.sh read it.
# Only ANTHROPIC_API_KEY is needed to use Claude; everything else has a working default.

# ---- Models
# Claude API key, used by anthropic: models (agents, judge, optimizer, agent drafting).
ANTHROPIC_API_KEY=
# Model for new agents. Default when unset: anthropic:claude-sonnet-5-5.
FORGE_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# Model for the eval judge, the optimizer and agent drafting. Falls back to FORGE_DEFAULT_MODEL when unset.
FORGE_GRADER_MODEL=anthropic:claude-opus-5-5
# Key sent to openai_compat: servers; local servers such as Ollama accept any value (default "not-needed").
# OPENAI_API_KEY=

# ---- Server
# Database and run artifacts. Default ./data.
FORGE_DATA_DIR=./data
# Where hosted runs execute: docker (sandbox containers, default) or local (host temp dirs; tests only).
FORGE_EXECUTOR=docker
# Docker image for sandboxes. Default forge-sandbox (built by `make image`).
# FORGE_SANDBOX_IMAGE=forge-sandbox
# Maximum concurrent hosted runs. Default 8.
# FORGE_MAX_CONCURRENCY=8
# Default eval repeats k for agents without their own setting (1 to 9, majority of k). Default 3.
# FORGE_EVAL_REPEATS=3
# JSON price overrides, USD per million tokens, e.g. {"anthropic:claude-sonnet-5-5": [2, 10]}.
# FORGE_PRICES=
# 1 serves Prometheus /metrics to remote clients too (default: localhost only).
# FORGE_METRICS_PUBLIC=0
# JSON run lifecycle logs on stderr: 1 on, 0 off; unset means on unless stderr is a terminal.
# FORGE_LOG_JSON=
# 1 disables every auth check, treating all clients as the local builder. Never set this on a shared server.
# FORGE_TRUST_ALL=0

# ---- Desktop app server entry (forge/desktop_entry.py; set by the macOS app)
# FORGE_HOST=127.0.0.1
# FORGE_PORT=8000
# PID of the app process; the server exits when it is gone.
# FORGE_PARENT_PID=

# ---- Tools, webhooks and triggers
# 1 disables the SSRF address check for HTTP tools, remote MCP servers and callable webhooks (development and tests only).
# FORGE_ALLOW_PRIVATE_HTTP=0
# Seconds to connect to an MCP server.
# FORGE_MCP_CONNECT_TIMEOUT=
# Public base URL used in trigger hook paths and reply links (e.g. your tunnel URL).
# FORGE_PUBLIC_URL=
# 0 disables the trigger scheduler; seconds between scheduler checks (default 15).
# FORGE_SCHEDULER=1
# FORGE_SCHEDULER_INTERVAL=15
# Runs per hour per trigger (default 30) and seconds between GitHub/Slack delivery retries (default 1).
# FORGE_TRIGGER_RATE_LIMIT=30
# FORGE_TRIGGER_RETRY_BACKOFF=1
# Extra API origins triggers may post to besides https://api.github.com and https://slack.com (comma separated;
# a bare host means https; an origin without a port allows any port), e.g. GitHub Enterprise.
# FORGE_TRIGGER_API_HOSTS=
# Allowed Slack response_url prefixes (comma separated). Default https://hooks.slack.com/.
# FORGE_SLACK_RESPONSE_URL_PREFIXES=
# Tests only: the scheduler reads the current unix time from this file.
# FORGE_TEST_CLOCK_FILE=
# Generate buttons on share pages: suggestions per share token per hour.
# FORGE_ASSIST_SHARE_LIMIT=
# Directory with example agents (default demo/ in the checkout, or the bundled copy in the desktop app).
# FORGE_EXAMPLES_DIR=

# ---- Scripts and live tests
# Server that scripts/preflight.sh checks. Default http://localhost:8000.
# FORGE_URL=http://localhost:8000
# 1 runs live model tests (same as pytest -m live).
# FORGE_LIVE=0
# Agent and judge models for live Claude tests. Defaults: the agent default model, anthropic:claude-opus-5-5.
# FORGE_LIVE_MODEL=
# FORGE_LIVE_GRADER_MODEL=
# OpenAI-compatible server and model for the live local model test. Defaults: Ollama and qwen3:8b.
# FORGE_LOCAL_BASE_URL=http://localhost:11434/v1
# FORGE_LOCAL_MODEL=qwen3:8b
# vLLM endpoint for the live GPU test and preflight, including /v1 (see gpu/vllm_modal.py); model defaults to the first served.
# FORGE_VLLM_URL=
# FORGE_VLLM_MODEL=
# Browser tests (web/playwright.config.ts): port and data dir of the test server. Defaults: 8011 and a temp dir.
# FORGE_E2E_PORT=8011
# FORGE_E2E_DATA_DIR=
# Python end-to-end servers (tests/e2e): restrict their ports to a range, e.g. 8082-8089. Default: any free port.
# FORGE_PYTEST_E2E_PORTS=
