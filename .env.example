# Forge settings, generated from forge/settings.py by `uv run python scripts/gen_env_example.py`.
# Do not edit by hand: tests/test_settings.py fails when this file and the registry drift apart.
#
# Every setting except API keys and the data directory can be changed in the app (Settings page),
# so most lines are commented out. A variable set here wins over the app and shows there as read only.

# ---- Models
# Default agent model: Model given to new agents that do not pick one.
# FORGE_DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# Grader model: Model that judges evaluation runs and proposes improvements; empty means the default agent model.
# FORGE_GRADER_MODEL=
# OpenAI compatible endpoints: Servers such as Ollama or vLLM whose models agents can use; a key variable names where its key lives.
# FORGE_OPENAI_ENDPOINTS=[{"name":"Ollama","base_url":"http://localhost:11434/v1"}]
# Claude API key: Key for Claude models from console.anthropic.com.
ANTHROPIC_API_KEY=
# OpenAI compatible API key: Key sent to OpenAI compatible endpoints that do not name their own key variable.
OPENAI_API_KEY=

# ---- Sandbox
# Executor: Where agent tools run: docker isolates each run, local runs commands directly on this machine.
# FORGE_EXECUTOR=docker
# Sandbox image: Docker image every run starts from.
# FORGE_SANDBOX_IMAGE=forge-sandbox
# Sandbox CPUs: CPU cores each sandbox container may use.
# FORGE_SANDBOX_CPUS=1
# Sandbox memory: Memory limit of each sandbox container, such as 1g or 512m.
# FORGE_SANDBOX_MEMORY=1g
# Turn limit: Model turns a run may take before it stops with a timeout.
# FORGE_RUN_MAX_TURNS=30
# Time limit (seconds): Wall clock seconds a run may take before it stops with a timeout.
# FORGE_RUN_MAX_SECONDS=600

# ---- Evaluations
# Default eval repeats: Runs per eval case for agents without their own setting; a case passes on a strict majority.
# FORGE_EVAL_REPEATS=3
# Eval concurrency: Eval runs of one version that may run at the same time.
# FORGE_EVAL_CONCURRENCY=4
# Auto improve threshold: New thumbs down that start an improvement cycle for agents with auto promote on.
# FORGE_AUTO_IMPROVE_THRESHOLD=3

# ---- Server
# Max concurrent runs: Runs that may execute at once; the rest wait in a queue. Needs a restart.
# FORGE_MAX_CONCURRENCY=8
# Data directory: Folder holding the database and run artifacts; it can only be set in the environment. Needs a restart.
# FORGE_DATA_DIR=./data
# Trust every client: Treat every request as local builder access; only for trusted networks and only from the environment.
# FORGE_TRUST_ALL=0

# ---- Observability
# JSON run logs: Write one JSON log line per run event; auto turns it on when the output is not a terminal. Needs a restart.
# FORGE_LOG_JSON=
# Public metrics: Serve the Prometheus /metrics endpoint to remote clients, not only to this machine.
# FORGE_METRICS_PUBLIC=0

# ---- Pricing
# Model prices: Extra or overriding prices in USD per million input and output tokens, by model string or Claude id.
# FORGE_PRICES={}

# ---- Sharing
# Public URL: Address others use to reach this Forge, used in share links and API examples.
# FORGE_PUBLIC_URL=
